---
/*
  Ficha de servicio (MAPA §3 "Plantilla de servicio"): #servicio → #alcance → #clave → #relacionados → #contacto (brand).
  #proyectos se omite hasta tener casos (Q18). Datos: src/data/servicios.js (sobre site.js).
  Contrato: #servicio primero en <main>; el rótulo viajero [data-rotulo-dest] id="rotulo" con la clase global .rotulo (MISMO cuerpo de letra
  que el [data-rotulo] de la fila del home); <link rel="expect"> en el head para que exista cuando corre pagereveal. Si el H1 empieza por el
  nombre del servicio (mantenimiento, instalación), el rótulo ES la primera línea del H1 (texto del H1 intacto, sin repetir el nombre); si
  no (restauración), va encima como antetítulo. Las filas de #relacionados también llevan [data-rotulo]: de ficha a ficha viaja igual.
  Sin data-reveal en el primer viewport (regla 13): #alcance puede asomar en él (390×844), así que tampoco lleva.
  Movimiento v2 (MOVIMIENTO-V2 §6), la gramática del home, todo CSS dentro de la puerta única (§4.1) salvo la contracción (contrae.js):
    #servicio      salida en planos como el hero: texto [data-plano=medio], figura [data-plano=lento] con la imagen en Vidrio modo salida
                   (se acerca y se empaña; deshielo al cargar salvo llegada por VT). Con scrollY = 0 nada está trasladado: el rótulo
                   aterriza sin salto. En instalación, el Equipo (ventiladores quietos: QA v2).
    #alcance       ≥900 px: "Qué incluye" sticky mientras corre la lista. El check cristaliza y la regla inferior se tiende; el texto nunca se
                   oculta (puede asomar en el primer viewport). H2 con contracción.
    #clave         el texto se contrae línea a línea y su barra cian crece hacia abajo.
    #relacionados  filas desde la derecha, escalonadas (se anima el li; el rótulo solo se traslada con él).
*/
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Contacto from '../../components/home/Contacto.astro';
import Vidrio from '../../components/ui/Vidrio.astro';
import Equipo from '../../components/ui/Equipo.astro';
import { paginas } from '../../data/servicios.js';
import { wa } from '../../data/site.js';
import { fotos, sizesFicha } from '../../data/fotos.js';
import { url } from '../../lib/url.js';

export function getStaticPaths() {
  return paginas.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props;
const path = `/servicios/${s.slug}/`;

// MAPA §4 por página: BreadcrumbList + Service, solo con SITE_URL (sin dominio no hay URL absolutas que declarar).
const abs = (p) => new URL(url(p), Astro.site).href;
const jsonLd = Astro.site && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: abs('/#servicios') },
        { '@type': 'ListItem', position: 3, name: s.name, item: abs(path) },
      ],
    },
    {
      '@type': 'Service',
      name: s.h1,
      serviceType: s.name,
      description: s.description,
      url: abs(path),
      provider: { '@id': `${abs('/')}#empresa` },
      areaServed: { '@type': 'Country', name: 'Venezuela' },
    },
  ],
};
const igCode = s.clave.source?.replace(/^IG /, '');
const enH1 = s.h1.startsWith(s.name); // el rótulo abre el H1

// Imagen de la ficha, en Vidrio (modo salida, como el hero): la foto del servicio (fotos.js; mantenimiento, restauración) en 4:5 o, sin
// foto (instalación: la del IG era de 640 px y Q18), el dibujo del equipo en un vidrio cuadrado. Solo desde 1024 px, donde la foto es el
// LCP: eager + fetchpriority high, y desde={1024} evita que se descargue por debajo (la figura no se pinta).
const foto = fotos[s.slug];
---
<Base title={s.title} description={s.description}>
  <link slot="head" rel="expect" href="#rotulo" blocking="render" />
  {jsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <section id="servicio" class="section ficha" data-theme="light" aria-labelledby="servicio-title" data-salida>
    <div class="container">
      <nav class="migas" aria-label="Ruta de navegación">
        <ol role="list">
          <li><a href={url('/')}>Inicio</a></li>
          <li><a href={url('/#servicios')}>Servicios</a></li>
          <li><span aria-current="page">{s.name}</span></li>
        </ol>
      </nav>
      <div class="ficha__grid">
        <div data-plano="medio">
          {enH1 ? (
            <h1 id="servicio-title"><span id="rotulo" class="rotulo ficha__rotulo" data-rotulo-dest>{s.name}</span>{s.h1.slice(s.name.length)}</h1>
          ) : (
            <>
              <p id="rotulo" class="rotulo ficha__rotulo" data-rotulo-dest>{s.name}</p>
              <h1 id="servicio-title">{s.h1}</h1>
            </>
          )}
          <p class="lead">{s.intro}</p>
          <div class="btn-row"><Button href={wa('servicios', s.waText)} size="lg" icon="whatsapp" iconPosition="start">{s.cta}</Button></div>
        </div>
        <div class:list={['ficha__fig', foto && 'ficha__fig--foto']} data-plano="lento">
          {foto ? (
            <Vidrio img={foto} modo="salida" ar="4/5" sizes={sizesFicha} desde={1024} loading="eager" fetchpriority="high" />
          ) : (
            <Vidrio modo="salida" ar="1/1"><Equipo /></Vidrio>
          )}
        </div>
      </div>
    </div>
  </section>

  <section id="alcance" class="section ficha-sec" data-theme="light" aria-labelledby="alcance-title">
    <div class="container ficha__split">
      <header>
        <h2 id="alcance-title" class="ficha__h2" data-contrae>Qué incluye</h2>
        <p class="lead">{s.alcance}</p>
      </header>
      <ul class="alcance" role="list">
        {s.trabajos.map((t) => <li><Icon name="check" size={22} class="alcance__icon" />{t}</li>)}
      </ul>
    </div>
  </section>

  <section id="clave" class="section ficha-sec" data-theme="light" aria-labelledby="clave-title">
    <div class="container ficha__rule">
      <h2 id="clave-title" class="eyebrow">El criterio</h2>
      {s.clave.quote ? (
        <figure class="clave">
          <blockquote cite={`https://www.instagram.com/p/${igCode}/`}><p class="clave__text" data-contrae>“{s.clave.text}”</p></blockquote>
          <figcaption class="muted">Refridi, en Instagram</figcaption>
        </figure>
      ) : (
        <p class:list={['clave', 'clave__text', s.clave.text.length > 100 && 'clave__text--long']} data-contrae>{s.clave.text}</p>
      )}
    </div>
  </section>

  <section id="relacionados" class="section ficha-sec" data-theme="light" aria-labelledby="relacionados-title">
    <div class="container ficha__rule">
      <h2 id="relacionados-title" class="eyebrow">También puede necesitar</h2>
      <ul class="rel" role="list" data-stagger="lado">
        {s.relatedServices.map((r) => (
          <li>
            <a class="rel__fila fila" href={url(`/servicios/${r.slug}/`)}>
              <span class="rotulo ficha__rotulo" data-rotulo>{r.name}</span>
              <span class="rel__text muted">{r.intro}</span>
              <Icon name="arrow-right" size={22} class="rel__arrow" />
            </a>
          </li>
        ))}
        {s.relatedLine && (
          <li>
            <a class="rel__fila fila" href={url(s.relatedLine.href)}>
              <span class="rotulo ficha__rotulo">{s.relatedLine.name}</span>
              <span class="rel__text muted">{s.relatedLine.text}</span>
              <Icon name="arrow-right" size={22} class="rel__arrow" />
            </a>
          </li>
        )}
      </ul>
    </div>
  </section>

  <Contacto cta={s.cta} waText={s.waText} />
</Base>

<script>
  import '../../scripts/contrae.js';
</script>

<style>
  /* Rótulo viajero: cuerpo de letra en la clase global .rotulo (base.css, el mismo que la fila del home). Aquí solo el color (allí --fg:
     el cruce de color es suave) y que sea bloque: width: fit-content → la caja es la del texto y solo se traslada. */
  .ficha__rotulo { display: block; width: fit-content; color: var(--link); }
  h1 > .ficha__rotulo { margin-bottom: 0.4rem; }

  .ficha { padding-top: calc(var(--header-h) + clamp(20px, 3vw, 40px)); padding-bottom: clamp(48px, 6vw, 96px); }
  .ficha h1 { font-size: var(--step-4); max-width: 20ch; }
  .ficha p.ficha__rotulo + h1 { margin-top: 0.9rem; }
  /* pantallas bajas (1366×640, 1280×800, 1024×768): el CTA dentro del primer viewport aunque rótulo y H1 (restauración) ocupen varias líneas */
  @media (min-width: 768px) and (max-height: 820px) {
    .ficha { padding-top: calc(var(--header-h) + 12px); }
    .ficha h1 { font-size: var(--step-3); }
    .ficha p.ficha__rotulo + h1 { margin-top: 0.5rem; }
    .ficha .migas { margin-bottom: 4px; }
    .ficha p.lead { margin-block: 1rem 1.25rem; } /* p.: gana a la regla base de más abajo */
  }
  .ficha__grid { display: grid; }
  /* ≥960 px, como el hero del home: el primer viewport es solo la ficha (CTA y gráfico; #alcance empieza debajo) */
  @media (min-width: 960px) { .ficha { min-height: 100svh; display: grid; align-items: center; } }
  .ficha__fig { display: none; }
  @media (min-width: 1024px) {
    .ficha__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 88px); align-items: center; }
    /* como la foto del home: cabe en el primer viewport en pantallas bajas (svh: no cambia tras la carga); la foto en 4:5, el mismo alto */
    .ficha__fig { display: block; width: min(100%, calc(100svh - var(--header-h) - 180px)); min-width: 320px; justify-self: end; }
    .ficha__fig--foto { width: min(100%, calc((100svh - var(--header-h) - 180px) * 0.8)); min-width: 256px; }
  }
  .ficha-sec { padding-block: clamp(40px, 5vw, 80px); }
  .ficha .lead { margin-block: 1.5rem 2rem; }

  .migas { margin-bottom: clamp(12px, 2vw, 28px); }
  .migas ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; font-size: var(--step--1); color: var(--muted); }
  .migas li { display: inline-flex; align-items: center; }
  .migas li + li::before { content: '›' / ''; padding-inline: 0.6em; }
  .migas a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .migas [aria-current] { color: var(--fg); }

  .ficha__h2 { font-size: var(--step-3); }
  .ficha__split { display: grid; gap: clamp(24px, 4vw, 48px); }
  .ficha__split .lead { margin-top: 1rem; }
  @media (min-width: 900px) { .ficha__split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(40px, 6vw, 96px); align-items: start; } }

  .alcance { list-style: none; border-top: 1px solid var(--line); }
  .alcance li { position: relative; display: flex; gap: 0.85rem; align-items: baseline; padding-block: 14px; font-size: var(--step-1); line-height: 1.35; }
  /* la regla inferior es un ::after (no border) para poder tenderla con scale */
  .alcance li::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: var(--line); transform-origin: left; }
  .alcance li :global(.alcance__icon) { flex: none; color: var(--stroke); transform: translateY(0.2em); }

  .ficha__rule { border-top: 1px solid var(--line); padding-top: clamp(24px, 3vw, 40px); }
  .clave { position: relative; margin: 0; max-width: 46rem; padding-left: 1.25rem; }
  .clave::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--cyan); transform-origin: top; }
  .clave blockquote { margin: 0; }
  .clave__text { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 760; font-size: var(--step-3); line-height: 1.08; color: var(--fg); text-wrap: balance; }
  .clave__text--long { font-size: var(--step-2); line-height: 1.15; }
  .clave figcaption { margin-top: 0.75rem; font-size: var(--step--1); }

  .rel { list-style: none; border-top: 1px solid var(--line); }
  .rel__fila {
    position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.35rem 1.5rem; align-items: center;
    padding-block: clamp(18px, 2.4vw, 28px); padding-inline: 4px; border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) { .rel__fila { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto; } }
  .rel__fila::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; background: color-mix(in srgb, var(--cyan) 9%, var(--bg)); transition: opacity var(--d-1) var(--ease-brand); }
  .rel__text { font-size: var(--step-0); line-height: 1.45; grid-column: 1; }
  @media (min-width: 900px) { .rel__text { grid-column: 2; } }
  .rel__fila :global(.rel__arrow) { grid-column: -2; grid-row: 1 / span 2; color: var(--link); transition: transform var(--d-1) var(--ease-brand); }
  @media (min-width: 900px) { .rel__fila :global(.rel__arrow) { grid-row: 1; } }
  @media (hover: hover) and (pointer: fine) {
    .rel__fila:hover::before { opacity: 1; }
    .rel__fila:hover :global(.rel__arrow) { transform: translateX(0.4rem); }
  }
  .rel__fila:focus-visible::before { opacity: 1; }
  .rel__fila:focus-visible :global(.rel__arrow) { transform: translateX(0.4rem); }

  /* ---------- #alcance: desde 900 px, "Qué incluye" se queda fijo a la izquierda mientras corre la lista (sin animación; en táctil
     <900 px la ficha va en una columna y no hay sticky) ---------- */
  @media (min-width: 900px) { .ficha__split > header { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; } }

  /* ---------- movimiento (MOVIMIENTO-V2 §6). Lo ligado al scroll en linear; reglas, barra y check en brand ----------
     Timelines con nombre en la fila / el bloque: un ::after de 1 px o un icono de 22 px darían un entry de 1-22 px (salto seco).
     El check cristaliza mientras su fila entra (entry 40 % → cover 25 %: visible, no un parpadeo). La regla, en entry 20 % → cover 45 %. */
  @keyframes cristalizar { from { opacity: 0; scale: 0.4; rotate: -20deg; } }
  @keyframes clave-barra { from { scale: 1 0; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(:root:not(.calm):not(.is-lite)) .alcance li { view-timeline: --alc block; }
      :global(:root:not(.calm):not(.is-lite)) .alcance li :global(.alcance__icon) {
        animation: cristalizar var(--ease-brand) both; animation-duration: auto; animation-timeline: --alc; animation-range: entry 40% cover 25%;
      }
      :global(:root:not(.calm):not(.is-lite)) .alcance li::after {
        animation: filete var(--ease-brand) both; animation-duration: auto; animation-timeline: --alc; animation-range: entry 20% cover 45%;
      }
      :global(:root:not(.calm):not(.is-lite)) .clave { view-timeline: --clave block; }
      :global(:root:not(.calm):not(.is-lite)) .clave::before {
        animation: clave-barra var(--ease-brand) both; animation-duration: auto; animation-timeline: --clave; animation-range: entry 10% cover 40%;
      }
    }
  }
</style>

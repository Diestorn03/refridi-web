---
/*
  Pie (MAPA §3 Chrome, CONCEPTO §4 Cierre): el único navy del sitio (data-theme="dark"). Isotipo ≤64 px que da UNA vuelta ligada al
  scroll mientras el pie entra (animation-timeline del propio pie, rotate(-1turn) → 0, curva brand) y queda quieto; solo donde hay
  view() y nunca con reduced / calm / lite. Las 3 líneas de WhatsApp, tel:, mailto:, colofón estático en Archivo con tabular-nums
  (razón social, dirección y horario; sin RIF hasta Q9), páginas, redes con @arir_ve, interruptor "Reducir movimiento" (setCalm del
  motor, src/scripts/chrome.js) y la marca "Vista previa" solo en staging. Sin /privacidad/ en la propuesta (la página aún no existe).
  Contrato que NO cambia: es `body > footer` (engine.js lo mide en layoutSig; chrome.js lee su data-theme).
  Movimiento v2 (MOVIMIENTO-V2 §5.8): además del giro, las columnas del pie se asientan escalonadas ([data-stagger] en la rejilla: marca y
  4 columnas, --i 0-4; base.css usa un rango entry para que al final del documento terminen). Nada más: el sitio termina quieto.
*/
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { brand, contact, lines, wa, waText, legal, social, services, nav, demo } from '../../data/site.js';
import { url, ext, nuevaPestana } from '../../lib/url.js';
import { waPagina } from './wa-pagina.js';

const nueva = ` ${nuevaPestana}`;
const whats = [
  { line: lines.servicios, href: wa('servicios', waPagina(Astro.url.pathname)) },
  { line: lines.repuestos, href: wa('repuestos', waText.repuestos) },
  { line: lines.academia, href: wa('academia', waText.academia) },
];
const pages = [
  ...services.map((s) => ({ href: url(`/servicios/${s.slug}/`), label: s.name })),
  ...nav.slice(1, 3).map((n) => ({ href: url(n.path), label: n.label })), // Repuestos, Academia
];
const redes = [
  { href: social.instagram, icon: 'instagram', label: 'Instagram', handle: social.instagramHandle },
  { href: social.tiktok, icon: 'tiktok', label: 'TikTok', handle: '@refridi' },
  { href: social.facebook, icon: 'facebook', label: 'Facebook', handle: 'refridi' },
  { href: social.arir, icon: 'instagram', label: 'Academia ARIR', handle: social.arirHandle },
] as const;
---
<footer class="pie" data-theme="dark">
  <div class="container">
    <div class="pie__grid" data-stagger>
      <div class="pie__marca">
        <div class="pie__giro" aria-hidden="true"><Logo name={false} size={56} variant="oscuro" /></div>
        <p class="pie__lema">{brand.tagline}</p>
        <p class="pie__colofon">
          <span>{legal.company}</span>
          <span>{contact.street}</span>
          <span>{contact.city} {contact.postalCode}, {contact.region}</span>
          {contact.hours.map((h) => <span>{h.label}: {h.text}</span>)}
        </p>
      </div>

      <div class="pie__col">
        <h2 class="pie__h">WhatsApp</h2>
        <ul class="pie__list">
          {whats.map(({ line, href }) => (
            <li><a href={href} {...ext}><Icon name="whatsapp" size={18} /><span class="pie__dos"><span>{line.label}</span><span class="pie__num">{line.display}</span></span><span class="sr-only">{nueva}</span></a></li>
          ))}
        </ul>
      </div>

      <div class="pie__col">
        <h2 class="pie__h">Teléfono y correo</h2>
        <address class="pie__list">
          <a href={contact.phone.tel}><Icon name="phone" size={18} /><span class="pie__num pie__dato">{contact.phone.display}</span></a>
          <a href={contact.emailHref}><Icon name="mail" size={18} /><span class="pie__num pie__dato">{contact.email}</span></a>
          <a href={contact.mapsUrl} {...ext}><Icon name="pin" size={18} /><span>Ver en Google Maps</span><span class="sr-only">{nueva}</span></a>
        </address>
      </div>

      <nav class="pie__col" aria-label="Pie de página">
        <h2 class="pie__h">Servicios</h2>
        <ul class="pie__list">
          {pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>

      <div class="pie__col">
        <h2 class="pie__h">Redes</h2>
        <ul class="pie__list">
          {redes.map((r) => (
            <li><a href={r.href} {...ext}><Icon name={r.icon} size={18} /><span class="pie__dos"><span>{r.label}</span><span class="pie__num">{r.handle}</span></span><span class="sr-only">{nueva}</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pie__base">
      <button class="calm" type="button" data-calm aria-pressed="false">
        <span class="calm__track" aria-hidden="true"><span class="calm__thumb"></span></span>
        <span>Reducir movimiento</span>
        <span class="calm__note">(activado en su sistema)</span>
      </button>
      {demo && <p class="pie__demo">Vista previa</p>}
    </div>
  </div>
</footer>

<script>
  import '../../scripts/chrome.js';
</script>

<style>
  .pie { background: var(--bg); color: var(--fg); padding-block: clamp(56px, 7vw, 96px) max(24px, env(safe-area-inset-bottom)); view-timeline: --pie block; }

  .pie__grid { display: grid; gap: 40px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr)); }
  @media (min-width: 1100px) { .pie__grid { grid-template-columns: 1.3fr 1fr 1.15fr 1fr 1fr; } }
  .pie__marca { display: grid; align-content: start; justify-items: start; gap: 16px; }
  .pie__lema { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 760; font-size: var(--step-2); line-height: 1.05; max-width: 14ch; }
  /* colofón: placa de datos fija, Archivo de etiqueta con cifras tabulares (no se anima) */
  .pie__colofon { display: grid; font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-variant-numeric: tabular-nums; font-size: var(--step--1); line-height: 1.55; color: var(--muted); }
  .pie__colofon span:first-child { color: var(--fg); }

  .pie__h { margin-bottom: 8px; font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-size: var(--step--1); line-height: 1.3; letter-spacing: 0.01em; color: var(--stroke); }
  .pie__list { display: grid; list-style: none; font-style: normal; }
  .pie__list a { display: inline-flex; align-items: center; gap: 0.65rem; min-height: var(--tap); padding-block: 4px; border-radius: var(--radius); color: var(--fg); overflow-wrap: anywhere; }
  .pie__list :global(.icon) { color: var(--stroke); }
  .pie__dos { display: grid; line-height: 1.25; }
  .pie__num { font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-variant-numeric: tabular-nums; font-size: var(--step--1); color: var(--muted); }
  .pie__dato { color: var(--fg); overflow-wrap: anywhere; }
  @media (hover: hover) and (pointer: fine) {
    .pie__list a:hover > span:not(.pie__dos), .pie__list a:hover .pie__dos > :first-child { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  }

  /* ---------- giro del isotipo: UNA vuelta mientras entra el pie; el wrapper es HTML y su centro es el (0,0) del viewBox ---------- */
  .pie__giro { width: 56px; height: 56px; }
  @keyframes pie-giro { from { transform: rotate(-1turn); } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not(.calm):not(.is-lite)) .pie__giro {
        animation: pie-giro linear both;
        animation-duration: auto;
        animation-timing-function: var(--ease-brand);
        animation-timeline: --pie;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  /* ---------- base: interruptor y marca de staging ---------- */
  .pie__base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; margin-top: clamp(40px, 5vw, 64px); padding-top: 12px; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--muted); }
  .pie__demo { display: inline-flex; align-items: center; min-height: 28px; padding: 0 10px; border: 1px solid var(--line); border-radius: var(--radius); font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; color: var(--muted); }

  /* "Reducir movimiento": botón con aria-pressed; el pulgar se desplaza con transform */
  .calm { display: inline-flex; align-items: center; gap: 0.75rem; min-height: var(--tap); border-radius: var(--radius); color: var(--fg); }
  .calm[disabled] { cursor: default; opacity: 0.8; }
  .calm__track { position: relative; flex: none; width: 38px; height: 22px; border: 1px solid var(--muted); border-radius: 11px; }
  .calm__thumb { position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--fg); transition: transform var(--d-1) var(--ease-brand); }
  .calm[aria-pressed='true'] .calm__track { background: var(--stroke); border-color: var(--stroke); }
  .calm[aria-pressed='true'] .calm__thumb { transform: translateX(16px); background: var(--bg); }
  /* la nota la decide el CSS (antes la mostraba el JS tras la carga y el pie crecía 36 px en móvil: regla 1) */
  .calm__note { display: none; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .calm__note { display: inline; } }
  :global(html:not(.js)) .calm { display: none; }
</style>

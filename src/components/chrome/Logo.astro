---
/*
  Isotipo PROVISIONAL de Refridi (docs/MARCA.md §1.2-1.3), redibujado con cúbicas que pasan por las tablas de §1.2: aspa de ~135°
  (punta viva en el vértice, grosor máx. 0,49 R, borde interior en arco del buje), hoja cian que tapa el vértice antes del aspa, buje
  hueco r = 0,14 R. viewBox -60 -60 120 120 con el centro de giro en (0,0) y R = 56; triángulo que apunta a la derecha. Módulo
  replicado a 120° y 240° con las coordenadas horneadas (sin <use> ni transform). Desvío máx. contra las tablas: 0,012 R.
  POR CONFIRMAR Q7: se reemplaza con el vector original (o con el calco aprobado sobre el avatar, MARCA §1.3 paso 5).

  "Refridi" al lado es TEXTO del sitio en Archivo: provisional de staging, se reemplaza por el wordmark real con Q7 (Q7.6: ¿"Refridi"
  o "Refridi, C.A."?). Nunca el wordmark recompuesto con una fuente parecida.

  <Logo />                                 isotipo 32 px + nombre; aspas en currentColor (siguen el --fg del tema)
  <Logo size={36} />                       cabecera
  <Logo name={false} size={56} variant="oscuro" />   pie: aspas blancas
  variant: auto (currentColor) | claro (aspas --ink, hojas --cyan, MARCA §1.4 v4) | oscuro (aspas --white, MARCA §1.4 v1/v3)
*/
import { brand } from '../../data/site.js';
interface Props { name?: boolean; size?: number; variant?: 'auto' | 'claro' | 'oscuro'; class?: string }
const { name = true, size = 32, variant = 'auto', class: cls } = Astro.props;

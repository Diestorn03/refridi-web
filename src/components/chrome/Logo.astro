<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.22); color: inherit; }
  .logo--claro { color: var(--ink); }
  .logo--oscuro { color: var(--white); }
  .logo__iso { flex: none; }
  .logo__aspas { fill: currentColor; }
  .logo__hojas { fill: var(--cyan); }
  /* provisional (Q7): nombre del sitio en Archivo de ancho normal, como el wordmark geométrico del logo (MARCA §1.1) */
  .logo__name { font-family: var(--font-display); font-stretch: 100%; font-weight: 760; font-size: calc(var(--logo-size) * 0.62); line-height: 1; letter-spacing: -0.01em; }
</style>

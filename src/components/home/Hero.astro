---
/* Hero (CONCEPTO §4 Hero, MAPA §3 fila 1) · escena "Azotea" (MOVIMIENTO-V2 §5.1 + AJ2). Contrato: section#inicio[data-theme=light], primer
   hijo de <main>, aria-labelledby="inicio-title"; el LCP (la foto o el H1) nunca espera al JS y no hay data-reveal (regla 13): el H1 no se
   anima. Un solo CTA (WhatsApp de servicios), sin tel:/mailto: ni tira de datos bajo el CTA: los datos van en la PLACA, fijada a la esquina
   inferior de la foto.
   Foto: [cliente · IG DYQZ9Y3u2-B] técnico lavando el condensador (4:5), en Vidrio modo "salida". Es el LCP medido (laptop y móvil):
   eager + fetchpriority high; sizes = el de fotos.hero (con tope de caja). POR CONFIRMAR Q21: sale una persona.
   Movimiento (CSS de base.css, 0 JS nuevo): al cargar, deshielo de la niebla (1,3 s), la raya del antetítulo se tiende y subtítulo, CTA
   y placa se asientan (.15/.25/.35 s); al bajar, salida
   en 3 planos sobre --salida (la sección): placa rápida, texto medio (se atenúa), figura lenta (la foto se acerca y se empaña). <960 px el
   timeline pasa a la figura y el texto queda quieto. reduced / calm / lite: foto limpia, sin deshielo ni planos.
   Placa: "40+ Años" (POR CONFIRMAR Q10), "Atención 24/7" (POR CONFIRMAR Q11), "A nivel nacional" (Q12); texto real en .sr-only y copia
   aria-hidden; src/scripts/placa.js decodifica una vez las cifras [data-placa-dig] en sus cajas fijas. */
import Button from '../ui/Button.astro';
import Vidrio from '../ui/Vidrio.astro';
import { home, wa, claims, legal } from '../../data/site.js';
import { fotos } from '../../data/fotos.js';

// "Refrigeración industrial y comercial:" va como antetítulo dentro del mismo H1 (un solo H1, texto intacto para SEO). Los dos puntos
// quedan solo para el lector de pantalla: a la vista colgaban al final de la línea.
const cut = home.h1.indexOf(': ');
const pre = cut > 0 ? home.h1.slice(0, cut + 1) : '';
const lema = cut > 0 ? home.h1.slice(cut + 2) : home.h1;
const sub = home.subtitle.split(' | ');
// "24/7" → cajas "24" y "7" con la "/" fija entre ellas: el decode solo toca cifras (antes la "/" también giraba: "2227")
const support = claims.support24 ? claims.support24.num.split(/(\d+)/).filter(Boolean) : [];
const years = claims.years && { digits: claims.years.num.replace(/\D.*$/, ''), rest: claims.years.num.replace(/^\d+/, '') };

---
<section id="inicio" class="section hero" data-theme="light" aria-labelledby="inicio-title" data-salida>
  <div class="container hero__grid">
    <div class="hero__txt" data-plano="medio">
      <h1 id="inicio-title" class="hero__h1">
        {pre && <span class="hero__pre">{pre.slice(0, -1)}<span class="sr-only">:</span>{' '}</span>}<span class="hero__lema">{lema}</span>
      </h1>
      <p class="hero__sub">{sub.map((t) => <><span>{t}</span>{' '}</>)}</p>
      <div class="btn-row"><Button href={wa('servicios', home.waText)} size="lg" icon="whatsapp" iconPosition="start">{home.cta}</Button></div>
    </div>

    <div class="hero__fig" data-plano="lento">
      {/* POR CONFIRMAR Q21 (persona) */}
      <Vidrio img={fotos.hero} modo="salida" ar="4/5" loading="eager" fetchpriority="high" />

      <div class="placa" data-plano="rapido">
        <p class="placa__marca">{legal.company}</p>
        <ul class="placa__datos" role="list">
          {years && (
            <li class="placa__dato">
              <span class="sr-only">{claims.years.num} {claims.years.text}</span>
              <span class="placa__num" aria-hidden="true"><span class="placa__dig placa__dig--2" data-placa-dig>{years.digits}</span><span class="placa__mas">{years.rest}</span></span>
              <span class="placa__txt" aria-hidden="true">{claims.years.text}</span>
            </li>
          )}
          {claims.support24 && (
            <li class="placa__dato">
              <span class="sr-only">{claims.support24.pre} {claims.support24.num}</span>
              <span class="placa__num" aria-hidden="true">{support.map((p) => (/^\d+$/.test(p) ? <span class="placa__dig" style={`width:${p.length}ch`} data-placa-dig>{p}</span> : <span class="placa__dig">{p}</span>))}</span>
              <span class="placa__txt" aria-hidden="true">{claims.support24.pre}</span>
            </li>
          )}
          {claims.coverage && <li class="placa__dato placa__dato--ancho"><span class="placa__txt">{claims.coverage.text}</span></li>}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/placa.js';
</script>

<style>
  .hero { padding-top: calc(var(--header-h) + clamp(28px, 6svh, 72px)); padding-bottom: clamp(64px, 8vw, 120px); }
  .hero__grid { display: grid; gap: clamp(48px, 6vw, 88px); align-items: center; }

  /* ---------- texto ---------- */
  .hero__h1 { font-size: clamp(2.5rem, 1.2rem + 4.2vw, 5.25rem); line-height: 0.98; }
  .hero__pre {
    display: block; margin-bottom: 0.9rem;
    font-stretch: var(--label-stretch); font-weight: 600; font-size: var(--step-1); line-height: 1.3; letter-spacing: 0.01em; color: var(--stroke);
  }
  .hero__pre::before { content: ''; display: inline-block; width: 28px; height: 3px; margin-right: 0.65em; vertical-align: 0.3em; background: var(--cyan); transform-origin: left; }
  /* la raya se tiende al cargar, con la misma puerta que el deshielo (sin VT, sin calm ni lite) */
  @keyframes tender { from { scale: 0 1; } }
  /* t0 (revisión final de v2): subtítulo, CTA y placa se asientan por tiempo tras el H1 (que no se anima: LCP), con la misma puerta que el
     deshielo. backwards sin forwards: al terminar manda la salida en planos (la placa la lleva en la misma lista, segunda) */
  @keyframes hero-asentar { from { opacity: 0; translate: 0 1.5rem; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.vt):not(.calm):not(.is-lite)) .hero__pre::before { animation: tender 0.5s var(--ease-brand) 0.15s both; }
    :global(html.js:not(.vt):not(.calm):not(.is-lite)) .hero__sub { animation: hero-asentar 0.7s var(--ease-brand) 0.15s backwards; }
    :global(html.js:not(.vt):not(.calm):not(.is-lite)) .hero__txt .btn-row { animation: hero-asentar 0.7s var(--ease-brand) 0.25s backwards; }
    :global(html.js:not(.vt):not(.calm):not(.is-lite)) .placa { animation: hero-asentar 0.7s var(--ease-brand) 0.35s backwards; }
    @supports (animation-timeline: view()) {
      :global(html.js:not(.vt):not(.calm):not(.is-lite)) .placa {
        animation: plano linear both, hero-asentar 0.7s var(--ease-brand) 0.35s backwards;
        animation-duration: auto, 0.7s; animation-timeline: --salida, auto; animation-range: exit 0% exit 100%, normal;
      }
    }
  }
  .hero__lema { display: block; }
  .hero__lema::first-letter { text-transform: uppercase; }
  .hero__sub {
    margin-block: clamp(20px, 3svh, 32px) clamp(28px, 4svh, 44px);
    font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-size: var(--step-1); line-height: 1.3; color: var(--muted);
  }
  /* separador decorativo (texto alternativo vacío). Al partirse la línea, el separador que queda al inicio cae fuera del clip-path */
  .hero__sub { display: flex; flex-wrap: wrap; margin-left: -1.3em; clip-path: inset(0 0 0 1.3em); }
  .hero__sub span { position: relative; margin-left: 1.3em; }
  .hero__sub span::before { content: '|'; content: '|' / ''; position: absolute; left: -0.82em; font-weight: 400; color: color-mix(in srgb, var(--muted) 55%, transparent); }

  /* ---------- foto ---------- */
  .hero__fig { position: relative; width: 100%; max-width: 36rem; container-type: inline-size; margin-bottom: calc(var(--gutter) * 0.5); }
  /* marco: .vidrio de base.css (Vidrio.astro), en 4:5 */

  /* ---------- placa de datos: chapa con remaches, fijada a la esquina inferior de la foto ---------- */
  .placa {
    --rivet: color-mix(in srgb, var(--ink) 34%, var(--surface));
    position: absolute; left: calc(var(--gutter) * -0.5); bottom: calc(var(--gutter) * -0.5);
    max-width: calc(100% - var(--gutter) * 0.5); padding: clamp(10px, 2.6cqi, 14px) clamp(16px, 4cqi, 22px) clamp(12px, 2.8cqi, 16px);
    border: 1px solid color-mix(in srgb, var(--ink) 24%, transparent); border-radius: var(--radius);
    background:
      radial-gradient(circle at 9px 9px, var(--rivet) 2.2px, transparent 2.9px),
      radial-gradient(circle at calc(100% - 9px) 9px, var(--rivet) 2.2px, transparent 2.9px),
      radial-gradient(circle at 9px calc(100% - 9px), var(--rivet) 2.2px, transparent 2.9px),
      radial-gradient(circle at calc(100% - 9px) calc(100% - 9px), var(--rivet) 2.2px, transparent 2.9px),
      repeating-linear-gradient(90deg, transparent 0 2px, color-mix(in srgb, var(--ink) 2.5%, transparent) 2px 3px),
      linear-gradient(165deg, var(--surface) 30%, color-mix(in srgb, var(--ink) 8%, var(--surface)));
    box-shadow: inset 0 1px 0 var(--surface), 0 14px 28px -18px color-mix(in srgb, var(--ink) 55%, transparent);
    color: var(--fg);
    font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.2;
  }
  .placa__marca { padding-bottom: 8px; border-bottom: 1px solid var(--line); font-size: var(--step--1); color: var(--muted); letter-spacing: 0.02em; }
  .placa__datos { list-style: none; display: grid; grid-template-columns: auto auto; }
  .placa__dato { display: flex; flex-direction: column; gap: 2px; padding: clamp(8px, 2.2cqi, 12px) clamp(14px, 4cqi, 22px) clamp(6px, 1.8cqi, 10px) 0; }
  .placa__dato + .placa__dato:not(.placa__dato--ancho) { padding-left: clamp(14px, 4cqi, 22px); padding-right: 0; border-left: 1px solid var(--line); }
  .placa__dato--ancho { grid-column: 1 / -1; padding: 8px 0 0; border-top: 1px solid var(--line); }
  .placa__num { font-size: var(--step-3); font-size: clamp(1.6rem, 7.6cqi, 3rem); line-height: 1; letter-spacing: -0.01em; white-space: nowrap; }
  .placa__mas { display: inline-block; font-size: 0.72em; vertical-align: 0.42em; margin-left: 0.04em; }
  .placa__txt { font-size: var(--step--1); color: var(--muted); }
  .placa__dato--ancho .placa__txt { font-size: var(--step-0); color: var(--fg); }
  /* cajas fijas del decode (regla 12): el ancho no depende del glifo que muestre ScrambleText */
  /* contain: layout alinea la caja por su borde inferior (línea base sintetizada): la "/" de 24/7 va en una caja igual (sin data-placa-dig)
     para quedar a la misma altura que las cifras */
  .placa__dig { display: inline-block; text-align: start; contain: layout paint; }
  .placa__dig--2 { width: 2ch; }

  @media (min-width: 960px) {
    /* el hero mide UN viewport (la foto, alta por el alto libre, + este padding = 100svh) y su --salida va sin inset (base.css): la salida
       en planos corre de scrollY 0 a 100svh (a la mitad, la placa va en −12vh respecto de la figura) */
    .hero { min-height: 100svh; display: grid; align-items: center; padding-bottom: calc(132px - clamp(28px, 6svh, 72px) - var(--gutter) * 0.5); }
    .hero__grid { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); }
    /* en pantallas bajas la foto cabe en el primer viewport: el mismo alto libre que tenía el gráfico cuadrado, a 4:5 (svh: no cambia tras
       la carga) */
    .hero__fig { justify-self: end; width: min(100%, calc((100svh - var(--header-h) - 132px) * 0.8)); min-width: 272px; }
  }
</style>

---
/* #contacto (brand): banda del CTA final (CONCEPTO §4 Cierre · MAPA §3 #8). La usan el home y las fichas de servicio, cada una con su CTA
   y su waText (props). tel: y mailto: solo aquí y en el pie. Sin "Soporte 24 hrs" hasta Q11; sin embed de mapa (Q22: enlace de búsqueda).
   La valoración de Google va como una línea mientras no exista #clientes (Q13/Q20).
   Movimiento v2 "Consigna mantenida" (MOVIMIENTO-V2 §5.7), CSS dentro de la puerta única (§4.1): el campo azul (.contacto__campo, capa
   propia detrás del contenido) se abre de .94 a borde completo al entrar; dos masas de vaho (1 bajo 768 px) cruzan la banda en sentidos
   contrarios; el H2 se contrae (contrae.js); entradilla, botón y valoración se asientan; las filas de datos se asientan y su regla se
   tiende. Fuera de la puerta: banda estática, campo completo y sin vaho. */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { home, contact, lines, wa, waText } from '../../data/site.js';
import { ext, nuevaPestana as newTab } from '../../lib/url.js';

interface Props { cta?: string; waText?: string }
const { cta = home.cta, waText: text = home.waText } = Astro.props;
const [ratingNum, ratingRest] = contact.rating.text.split('★');
---
<section id="contacto" class="section contacto" data-theme="brand" aria-labelledby="contacto-title">
  <div class="contacto__campo" aria-hidden="true"></div>
  <div class="contacto__vaho" aria-hidden="true"><i></i><i></i></div>
  <div class="container contacto__grid">
    <div class="contacto__cta">
      <p class="eyebrow">Contacto</p>
      <h2 id="contacto-title" data-contrae>{home.closing}</h2>
      <p class="lead" data-reveal>Escríbanos por WhatsApp qué equipo tiene y qué está pasando. Si lo prefiere, llame o envíe un correo.</p>
      <div class="btn-row" data-reveal style="--i:1"><Button href={wa('servicios', text)} size="lg" icon="whatsapp" iconPosition="start">{cta}</Button></div>
      <p class="contacto__rating" data-reveal style="--i:2">
        <a class="contacto__a" href={contact.rating.url} {...ext}>
          <span class="num">{ratingNum}</span><span aria-hidden="true" class="contacto__star">★</span><span class="sr-only">de 5 estrellas</span>{ratingRest}<span class="sr-only"> {newTab}</span>
        </a>
      </p>
    </div>

    <dl class="contacto__datos" data-stagger>
      <div>
        <dt><Icon name="phone" size={18} />Teléfono</dt>
        <dd><a class="contacto__a num" href={lines.servicios.tel}>{lines.servicios.display}</a></dd>
      </div>
      <div>
        <dt><Icon name="mail" size={18} />Correo</dt>
        <dd><a class="contacto__a" href={contact.emailHref}>{contact.email}</a></dd>
      </div>
      <div>
        <dt><Icon name="clock" size={18} />Horario</dt>
        <dd>{contact.hours.map((h) => <span class="contacto__line">{h.label}, <span class="num">{h.text}</span></span>)}</dd>
      </div>
      <div>
        <dt><Icon name="pin" size={18} />Dirección</dt>
        <dd>
          <span class="contacto__line">{contact.street}, {contact.streetNote}</span>
          <span class="contacto__line">{contact.city} {contact.postalCode}, {contact.region}</span>
          <a class="contacto__a" href={contact.mapsUrl} {...ext}>Ver en Google Maps<span class="sr-only"> {newTab}</span></a>
        </dd>
      </div>
      <div>
        <dt><Icon name="whatsapp" size={18} />Otras líneas</dt>
        <dd>
          <a class="contacto__a" href={wa('repuestos', waText.repuestos)} {...ext}>{lines.repuestos.label} <span class="num">{lines.repuestos.display}</span><span class="sr-only"> por WhatsApp {newTab}</span></a>
          <a class="contacto__a" href={wa('academia', waText.academia)} {...ext}>{lines.academia.label} <span class="num">{lines.academia.display}</span><span class="sr-only"> por WhatsApp {newTab}</span></a>
        </dd>
      </div>
    </dl>

  </div>
</section>

<script>
  import '../../scripts/contrae.js';
</script>

<style>
  /* el fondo vive en .contacto__campo (capa propia, para abrirlo con scale); la sección recorta campo, vaho y la contracción del H2 */
  .contacto { background: transparent; overflow: clip; }
  .contacto__campo { position: absolute; inset: 0; z-index: -1; background: var(--bg); }
  .contacto__grid { display: grid; gap: clamp(36px, 5vw, 64px); }
  @media (min-width: 900px) {
    .contacto__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: clamp(48px, 7vw, 112px); align-items: start; }
  }
  .contacto__cta .lead { margin-block: 1.25rem 2rem; }

  .contacto__datos { margin: 0; border-top: 1px solid var(--line); }
  .contacto__datos > div {
    display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 4px 16px; align-items: baseline;
    position: relative; padding-block: 14px;
  }
  /* la regla inferior es un ::after (no border) para poder tenderla con scale */
  .contacto__datos > div::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: var(--line); transform-origin: left; }
  .contacto__datos dt {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: var(--tap);
    font-family: var(--font-display); font-stretch: var(--label-stretch); font-weight: 600; font-size: var(--step--1); color: var(--stroke);
  }
  .contacto__datos dd { margin: 0; display: grid; justify-items: start; align-content: center; min-height: var(--tap); overflow-wrap: anywhere; }
  .contacto__line { display: block; }
  /* enlaces de la banda: blancos y subrayados, objetivo ≥44 px */
  .contacto__a {
    display: inline-block; padding-block: 10px; line-height: 1.5; /* ≥44 px de alto sin partir el subrayado */
    color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.22em;
  }
  .contacto__a.num { font-size: var(--step-1); }
  @media (hover: hover) and (pointer: fine) { .contacto__a:hover { text-decoration-thickness: 2px; } }
  @media (max-width: 479px) {
    .contacto__datos > div { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .contacto__datos dt { min-height: 0; }
  }

  .contacto__rating { margin-top: 1.5rem; }
  .contacto__star { color: var(--stroke); }

  /* ---------- movimiento (MOVIMIENTO-V2 §5.7) ----------
     Campo: scale .94 .92 → 1 en entry 0-70 % de la sección (brand). A .94 de ancho sigue cubriendo el contenedor de 320 a 2560 px (el
     contenedor ocupa como mucho el 92,8 % del ancho): el texto blanco nunca queda sobre papel; .90 (lo que pedía la revisión final) lo
     destapaba por debajo de ~1300 px. El alto a .92 (centro) recoge como mucho el 4 % arriba, menos que el padding (--section-y).
     Vaho: radial blanco, 60vw × 40svh, linear en cover 0-100 %; uno de abajo-izquierda a arriba-derecha y el otro al revés, en bandas
     distintas (nunca se suman en el centro). Opacidad del vaho: 6 % en «feed» (con el 18 % de la §5.7 el --muted y el --stroke caen a
     3,4:1 sobre el azul rey; al 6 % quedan en 4,57:1, AA) y 18 % en «acero» (6,2:1 sobre el grafito). */
  .contacto__vaho { display: none; position: absolute; inset: 0; z-index: -1; pointer-events: none; --vaho: rgb(255 255 255 / 0.06); }
  :global([data-palette='acero']) .contacto__vaho { --vaho: rgb(255 255 255 / 0.18); }
  .contacto__vaho i { position: absolute; width: 60vw; height: 40svh; background: radial-gradient(closest-side, var(--vaho), transparent); }
  /* el que sube va arriba y el que baja, abajo: se separan al avanzar (lo más cerca, en cover 0 %, quedan a ~20svh) */
  .contacto__vaho i:first-child { left: -8vw; top: 4%; --desde: -10vw 8svh; --hasta: 10vw -8svh; }
  .contacto__vaho i:last-child { right: -8vw; bottom: 4%; --desde: 10vw -8svh; --hasta: -10vw 8svh; }
  @keyframes campo-abrir { from { scale: 0.94 0.92; } }
  @keyframes vaho-cruzar { from { translate: var(--desde); scale: 1; } to { translate: var(--hasta); scale: 1.15; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(:root:not(.calm):not(.is-lite)) .contacto__campo {
        animation: campo-abrir var(--ease-brand) both; animation-duration: auto; animation-timeline: view(); animation-range: entry 0% entry 70%;
      }
      :global(:root:not(.calm):not(.is-lite)) .contacto { view-timeline: --consigna block; }
      :global(:root:not(.calm):not(.is-lite)) .contacto__vaho { display: block; }
      :global(:root:not(.calm):not(.is-lite)) .contacto__vaho i {
        animation: vaho-cruzar linear both; animation-duration: auto; animation-timeline: --consigna; animation-range: cover 0% cover 100%;
      }
      :global(:root:not(.calm):not(.is-lite)) .contacto__datos > div { view-timeline: --dato block; }
      :global(:root:not(.calm):not(.is-lite)) .contacto__datos > div::after {
        animation: filete var(--ease-brand) both; animation-duration: auto; animation-timeline: --dato; animation-range: entry 40% cover 40%;
      }
    }
  }
  @media (max-width: 767px) { .contacto__vaho i:last-child { display: none; } }
</style>

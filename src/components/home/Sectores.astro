---
/*
  #sectores (brand, MAPA §3 #4) · escena firma "La Cortina" (CONCEPTO §5). La única escena sticky del sitio. Todo CSS: 0 JS por cuadro.
  Sin sonda: Q19 sin respuesta → sin cava.js, sin .cava__ctl y sin ScrambleText (cuando llegue Q19 se suman los tres).
  Contrato: hijo directo de <main>, id="sectores", data-theme="brand", encabezado #sectores-title.
  Estructura:
    .cava__pista   alto var(--alto) (180svh; 140svh con pointer:coarse: sin sonda, Q19, no hace falta la espera de 200/150), view-timeline --cava. El timeline va en la pista y no en la sección:
                   así "contain" = exactamente mientras el sticky está fijo (la sección también contiene la lista de sectores).
    .cava__sticky  sticky, top 0, 100svh, overflow clip, con el riel pintado en su fondo: escarcha (esquinas) · interior (eyebrow + H2,
                   visible al 35 % detrás de las tiras desde el principio: la cortina tapa algo) · cortina (8 tiras; 6 en <768 px).
    Después, en flujo normal y con el reveal estándar: los 4 sectores con su línea.
  Gates (CSS + clases del head, antes del primer pintado): la versión ESTÁTICA es la de por defecto (pista auto, sticky static, cortina
  oculta, interior visible). La escena solo se enciende con no-preference + min-height 600px + view() + html sin .calm ni .is-lite.
*/
import { sectors } from '../../data/site.js';
import { asset } from '../../lib/url.js';

// Tiras de PVC, calculadas en el build. Orden del DOM: de fuera hacia dentro y por parejas (izq., der.), así las de dentro pintan encima
// en los dos lados. Cada nodo lleva su juego de 8 (≥768 px) y los 6 primeros, también el de 6 (<768 px).
//   x: centro con la cortina cerrada (% del ancho) · w: ancho (%) · dx: desplazamiento final (vw) · rot: giro final (la base se va
//   hacia afuera) · k: 0 = junto al centro (arranca antes y llega antes).
//   marco: vw que quedan a la vista en cada lado con la cortina abierta · paso: separación del atado · giro: grados de la tira central.
const juego = (n, marco, paso, giro) => {
  const m = n / 2, w = 100 / n + 1.5;
  return Array.from({ length: n }, (_, d) => {
    const s = d % 2 ? 1 : -1, k = m - 1 - Math.floor(d / 2);
    const x = 50 + s * (k + 0.5) * (100 / n);
    const fin = 50 + s * (50 - marco + w / 2 + k * paso);
    return { x, w, dx: fin - x, rot: -s * (giro - k), k };
  });
};
const f = (v) => +v.toFixed(2);
const vars = (t, n) => `--x${n}:${f(t.x)};--w${n}:${f(t.w)};--dx${n}:${f(t.dx)}vw;--rot${n}:${t.rot}deg;--k${n}:${t.k}`;
const ocho = juego(8, 13, 3, 5);
const seis = juego(6, 9, 2.5, 4);
const tiras = ocho.map((t, d) => vars(t, 8) + (seis[d] ? ';' + vars(seis[d], 6) : ''));
---
<section id="sectores" class="cava" data-theme="brand" aria-labelledby="sectores-title">
  <div class="cava__pista">
    <div class="cava__sticky">
      <div class="cava__escarcha" aria-hidden="true" style={`--frost:url(${asset('img/frost.svg')})`}></div>
      <div class="cava__interior">
        <p class="eyebrow">Cada minuto de inactividad cuenta</p>{/* [cliente · IG Dd7h8WOO9-3] */}
        <h2 id="sectores-title">Detrás de la cortina, la temperatura no se negocia.</h2>{/* [redactado] */}
      </div>
      <div class="cava__cortina" aria-hidden="true">{tiras.map((s) => <i style={s}></i>)}</div>
    </div>
  </div>

  <div class="cava__sectores container">
    <p class="cava__intro" data-reveal>Trabajamos donde una falla de frío se convierte en merma.</p>{/* [redactado; "mermas": IG, MAPA instalación] */}
    {/* Sectores [cliente · IG destacado Servicios] · líneas [redactado] · sin clientes hasta Q13 */}
    <ul class="cava__lista" role="list" data-stagger>
      {sectors.map((s) => (
        <li class="cava__sector">
          <h3>{s.name}</h3>
          <p>{s.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ---------- estático (por defecto) ---------- */
  .cava { --alto: 180svh; position: relative; isolation: isolate; padding-bottom: var(--section-y); background: var(--bg); color: var(--fg); }
  @media (pointer: coarse) { .cava { --alto: 140svh; } }

  .cava__sticky { position: relative; display: grid; place-items: center; padding-top: var(--section-y); overflow: clip; }
  /* ancho ligado al cuerpo del H2 (6,4 × step-5 ≈ su línea más larga): la capa del interior no mide más que el texto, y con la
     cortina abierta el texto nunca queda debajo de las tiras */
  .cava__interior { position: relative; width: min(100% - 2 * var(--gutter), var(--step-5) * 6.4); text-align: center; }
  .cava__interior h2 { max-width: 15ch; margin-inline: auto; font-size: var(--step-5); }
  .cava__interior .eyebrow { font-size: var(--step-1); } /* la cita del cliente, legible sobre el azul bajo un H2 de 4 líneas */

  /* escarcha: frost.svg (compartida con el hero) solo en las 2 esquinas de arriba (las de abajo dejarían un corte recto al salir el
     sticky). La caja es una banda (no todo el sticky): la capa mide lo que pinta (memoria, CONCEPTO §5). El marco se mapea a 100 % del
     ancho × 75vw (4:3, el del viewBox) para que la textura no se estire en móvil; cada esquina queda dentro de su cuarto del marco y se
     funde hacia dentro con una máscara radial estática (sin cortes). Estática (0,35: más, sobre azul rey se lee como ruido) salvo en la escena. */
  .cava__escarcha { position: absolute; inset: 0 0 auto; height: clamp(120px, 22vw, 40svh); opacity: 0.35; pointer-events: none; }
  .cava__escarcha::before, .cava__escarcha::after {
    --c: 0 0; content: ''; position: absolute; top: 0; left: 0; width: 40%; height: 100%;
    background: var(--frost) var(--c) / 250% 75vw no-repeat;
    -webkit-mask-image: radial-gradient(farthest-side at var(--c), #000, transparent);
    mask-image: radial-gradient(farthest-side at var(--c), #000, transparent);
  }
  .cava__escarcha::after { --c: 100% 0; left: auto; right: 0; }

  /* cortina: tiras de PVC translúcidas (hielo ~50 %, filo de 1 px, dos nervios y un reflejo), colgadas desde arriba por su grapa. El riel
     es fondo del sticky (escena, abajo): fijo mientras las tiras giran, y sin capa nueva (presupuesto: 8 tiras + interior + escarcha).
     Colores solo por token (MARCA §2.4): el PVC es hielo (cian + blanco) en las dos paletas; el filo de sombra sigue a --ink. */
  .cava__cortina {
    --pvc: color-mix(in srgb, var(--cyan) 8%, var(--white));
    --pvc-2: color-mix(in srgb, var(--cyan) 22%, var(--white));
    --luz: color-mix(in srgb, var(--white) 20%, transparent);
    display: none; position: absolute; inset: 0; pointer-events: none;
  }
  .cava__cortina i {
    --x: var(--x8); --w: var(--w8); --dx: var(--dx8); --rot: var(--rot8); --k: var(--k8);
    position: absolute; top: 0; bottom: 0; left: calc((var(--x) - var(--w) / 2) * 1%); width: calc(var(--w) * 1%);
    transform-origin: 50% 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--white) 90%, transparent) 0 1px, transparent 1px calc(100% - 1px), color-mix(in srgb, var(--ink) 25%, transparent) calc(100% - 1px)),
      linear-gradient(90deg, transparent 5%, var(--luz) 5% 6%, transparent 6% 94%, var(--luz) 94% 95%, transparent 95%),
      linear-gradient(90deg, transparent 12%, color-mix(in srgb, var(--white) 30%, transparent) 22%, color-mix(in srgb, var(--white) 8%, transparent) 34%, transparent 46% 70%, color-mix(in srgb, var(--white) 12%, transparent) 80%, transparent 90%),
      linear-gradient(180deg, color-mix(in srgb, var(--pvc) 56%, transparent), color-mix(in srgb, var(--pvc-2) 36%, transparent) 55%, color-mix(in srgb, var(--pvc-2) 30%, transparent) 92%, color-mix(in srgb, var(--pvc) 60%, transparent));
  }
  /* grapa de cada tira */
  .cava__cortina i::before {
    content: ''; position: absolute; top: 0; left: 32%; right: 32%; height: 22px;
    background: linear-gradient(var(--white), color-mix(in srgb, var(--ink) 30%, var(--white))); border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 30%, transparent);
  }
  @media (max-width: 767px) {
    .cava__cortina i { --x: var(--x6); --w: var(--w6); --dx: var(--dx6); --rot: var(--rot6); --k: var(--k6); }
    .cava__cortina i:nth-child(n + 7) { display: none; }
  }

  /* lista de sectores, en flujo normal después del sticky */
  .cava__sectores { padding-top: clamp(56px, 7vw, 112px); }
  .cava__intro { max-width: 40ch; margin-bottom: clamp(32px, 4vw, 56px); font-size: var(--step-1); line-height: 1.45; color: var(--muted); }
  .cava__lista { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: clamp(32px, 3vw, 48px) clamp(24px, 3vw, 40px); }
  .cava__sector { position: relative; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .cava__sector::before { content: ''; position: absolute; top: -2px; left: 0; width: 3rem; height: 3px; background: var(--cyan); }
  .cava__sector h3 { margin-bottom: 0.6rem; }
  .cava__sector p { color: var(--muted); }

  /* ---------- escena (CONCEPTO §5 Mecánica): rango contain de la pista = mientras el sticky está fijo ---------- */
  @keyframes cava-abrir { to { transform: translateX(var(--dx)) rotate(var(--rot)); } }
  /* el interior arranca al 35 % (no en 0): mientras la cortina está cerrada el H2 se adivina detrás del PVC, así la escena revela algo */
  @keyframes cava-entrar { from { opacity: 0.35; transform: translateY(2rem); } }
  @keyframes cava-escarcha { from { opacity: 0; } }

  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) {
    @supports (animation-timeline: view()) {
      :global(:root:not(.calm, .is-lite)) .cava__pista { height: var(--alto); view-timeline: --cava block; view-timeline-inset: 0; }
      /* riel: platina de 7 px bajo el header, pintada en el fondo del sticky (no rota con las tiras) */
      :global(:root:not(.calm, .is-lite)) .cava__sticky {
        position: sticky; top: 0; height: 100svh; padding-top: var(--header-h);
        background: linear-gradient(color-mix(in srgb, var(--ink) 6%, var(--white)), color-mix(in srgb, var(--ink) 38%, var(--white)) 75%, color-mix(in srgb, var(--ink) 55%, var(--white))) 0 var(--header-h) / 100% 7px no-repeat;
      }
      :global(:root:not(.calm, .is-lite)) .cava__cortina { display: block; }
      /* tiras y escarcha cuelgan bajo el header fijo: con el sticky clavado se siguen viendo las grapas */
      :global(:root:not(.calm, .is-lite)) :is(.cava__cortina, .cava__escarcha) { top: var(--header-h); }
      /* el shorthand animation reinicia animation-timeline: va después */
      :global(:root:not(.calm, .is-lite)) .cava__cortina i {
        animation: cava-abrir var(--ease-brand) both; animation-duration: auto; animation-timeline: --cava;
        animation-range: contain calc(10% + var(--k) * 4%) contain calc(55% + var(--k) * 4%);
      }
      :global(:root:not(.calm, .is-lite)) .cava__interior {
        animation: cava-entrar var(--ease-brand) both; animation-duration: auto; animation-timeline: --cava; animation-range: contain 0% contain 40%;
      }
      :global(:root:not(.calm, .is-lite)) .cava__escarcha {
        animation: cava-escarcha var(--ease-brand) both; animation-duration: auto; animation-timeline: --cava; animation-range: contain 40% contain 70%;
      }
    }
  }
</style>
